# Infy Voice — provider configuration (copy to .env; never commit real keys)
#
# LLM provider:   llamacpp (in-process GGUF, local, free, default) |
#                 ollama (local server) | gemini (hosted, needs key)
LLM_PROVIDER=llamacpp
# GGUF_MODEL=models/Qwen2.5-3B-Instruct-Q4_K_M.gguf   (default; 1.5B alt: models/qwen2.5-1.5b-instruct-q4_k_m.gguf)
# GGUF_GPU_LAYERS=-1  (-1 = offload all layers to GPU when CUDA wheel + NVIDIA
#                      GPU present; 0 forces CPU)
#
# Ollama — local fallback when `ollama serve` is running:
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:8b        (qwen3/deepseek-r1 run with think=false automatically)
# OLLAMA_BASE=http://localhost:11434
# OLLAMA_KEEP_ALIVE=30m        (keep the model loaded between turns)
# GPU acceleration: the CUDA build of llama-cpp-python needs pip packages
# nvidia-cublas-cu12 nvidia-cuda-runtime-cu12 nvidia-cuda-nvrtc-cu12
# (already in requirements.txt — install adds ~2GB disk on C:)
#
# Max spoken-answer length for any LLM provider (tokens):
# LLM_MAX_TOKENS=180
#
# TTS provider:   edge (free Microsoft neural voices, default) | browser (offline fallback)
TTS_PROVIDER=edge
#
# Gemini REST path — hosted option (key sent as x-goog-api-key header, never in URLs)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash   (gemini-2.5-* is closed to new API keys)
#
# Gemini Live native-audio path (/api/tutor/live) also needs GEMINI_API_KEY.
#
# Voice mode: cascade (local STT->RAG->LLM->TTS, default when no key) |
#             live (Gemini realtime speech-to-speech) | auto (live if key set)
# VOICE_MODE=auto
# Spending guard for live mode: the ephemeral token AND the client both
# enforce this cap; a forgotten tab cannot burn usage past it.
# LIVE_MAX_SESSION_MINUTES=10
